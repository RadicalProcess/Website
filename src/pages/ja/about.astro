---
import Layout from '../../layouts/Layout.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import SiteHeader from '../../components/SiteHeader.astro';
---

<Layout
  title="概要 — Radical Process"
  description="Radical Process は、自分だけのサウンドを追い求めるアーティストのために、尖った、徹底的に作り込まれたオーディオプラグインを作っています。コミュニティ、お問い合わせ、運営者情報。"
>

  <SiteHeader lang="ja" />

  <main class="max-w-4xl mx-auto px-6 pb-20">

    <!-- ── ABOUT ──────────────────────────────────────────────────── -->
    <section class="pt-10">
      <h1 class="text-5xl sm:text-6xl font-black tracking-tight mb-8">概要</h1>

      <p class="text-gray-300 leading-relaxed max-w-2xl">
        Radical Process は、いまの音楽にあふれるありきたりなサウンドに甘んじないアーティストのために、尖った、偏執的なまでに作り込まれたオーディオプラグインを作っています。自分だけのシグネチャートーンを小数点以下の最後の一桁まで追い求める人のための、とことんニッチで、とことん深いツール。こだわりすぎる人のための道具です
        — そして、それ以外のあり方は考えていません。
      </p>
    </section>

    <hr class="border-gray-800 my-16" />

    <!-- ── COMMUNITY ──────────────────────────────────────────────── -->
    <section>
      <h2 class="text-sm font-semibold tracking-[0.25em] uppercase text-gray-400 mb-4">コミュニティ</h2>
      <p class="text-gray-300 leading-relaxed max-w-2xl">
        <a href="https://download.radical-process.com/discord" rel="noopener noreferrer" target="_blank"
           class="text-gray-300 underline underline-offset-4 decoration-2 decoration-gray-500 hover:text-white transition-colors">Discord</a>に参加して、機材の話をしたり、プリセットを共有したり、バグを報告したり、次に何を作っているのかを聞いたりしてください。
         </p>
    </section>

    <hr class="border-gray-800 my-16" />

    <!-- ── CONTACT ────────────────────────────────────────────────── -->
    <section>
      <h2 class="text-sm font-semibold tracking-[0.25em] uppercase text-gray-400 mb-4">お問い合わせ</h2>
      <p class="text-gray-300 leading-relaxed max-w-2xl">
        support at radical-process.com
      </p>
    </section>

    <hr class="border-gray-800 my-16" />

    <!-- ── IMPRESSUM ──────────────────────────────────────────────── -->
    <!-- German law requires the Impressum; it stays in German, as in English. -->
    <section id="impressum" class="scroll-mt-8">
      <h2 class="text-sm font-semibold tracking-[0.25em] uppercase text-gray-400 mb-4">運営者情報（Impressum）</h2>
      <p class="text-gray-300 leading-relaxed max-w-2xl mb-2">Angaben gemäß § 5 DDG</p>
      <address class="text-gray-300 leading-relaxed max-w-2xl not-italic">
        Chikashi Miyama<br />
        c/o Impressumservice Dein-Impressum<br />
        Stettiner Str. 41<br />
        35410 Hungen
      </address>
    </section>
  </main>

  <SiteFooter lang="ja" current="about" />

</Layout>
