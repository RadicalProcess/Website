---
import Layout from '../layouts/Layout.astro';
---

<Layout title="About — Radical Process">

  <!-- ── HEADER ──────────────────────────────────────────────────── -->
  <header class="max-w-4xl mx-auto px-6 pt-14 pb-4">
    <p class="text-xs uppercase text-gray-500">
      <a href="/" class="tracking-[0.45em] hover:text-gray-300 transition-colors">Radical Process</a>
      <span class="text-gray-600 tracking-[0.25em]">
        &nbsp;—&nbsp; Unapologetically niche, unapologetically deep
      </span>
    </p>
  </header>

  <main class="max-w-4xl mx-auto px-6 pb-20">

    <!-- ── ABOUT ──────────────────────────────────────────────────── -->
    <section class="pt-10">
      <h1 class="text-5xl sm:text-6xl font-black tracking-tighter mb-8">About</h1>

      <p class="text-gray-300 leading-relaxed max-w-2xl">
        Radical Process makes edgy, obsessively detailed audio plugins for artists who refuse to settle
        for the generic sound flooding music today. Built for those who chase their own
        signature tone down to the last decimal, our tools are unapologetically niche and
        unapologetically deep. This is gear for people who care too much—and wouldn't have it any
        other way.
      </p>
    </section>

    <hr class="border-gray-800 my-16" />

    <!-- ── CONTACT ────────────────────────────────────────────────── -->
    <section>
      <h2 class="text-sm font-semibold tracking-[0.25em] uppercase text-gray-400 mb-4">Contact</h2>
      <p class="text-gray-300 leading-relaxed max-w-2xl">
        support at radical-process.com
      </p>
    </section>

    <hr class="border-gray-800 my-16" />

    <!-- ── IMPRESSUM ──────────────────────────────────────────────── -->
    <section id="impressum" class="scroll-mt-8">
      <h2 class="text-[10px] font-semibold tracking-[0.25em] uppercase text-gray-500 mb-2">Impressum</h2>
      <address class="text-[10px] leading-relaxed text-gray-500 not-italic">
        Radical Process<br />
        Lange Heide 3<br />
        51069 Cologne<br />
        Germany
      </address>
    </section>
  </main>

  <footer class="border-t border-gray-900 text-center text-gray-600 text-xs py-10 tracking-widest uppercase">
    <p>
      <a href="/" class="hover:text-gray-400 transition-colors">Home</a>
      <span class="text-gray-800 mx-2">·</span>
      <a href="/privacy" class="hover:text-gray-400 transition-colors">Privacy</a>
    </p>
    <p class="mt-3">&copy; 2026 Radical Process. All rights reserved.</p>
  </footer>

</Layout>
