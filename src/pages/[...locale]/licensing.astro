---
import Layout from '../../layouts/Layout.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import { getLocalePaths, type Lang } from '../../i18n';
import copy from '../../translations/licensing';

export const getStaticPaths = getLocalePaths;

const { lang } = Astro.props as { lang: Lang };
const t = copy[lang];

const headingClass = 'text-sm font-semibold tracking-[0.25em] uppercase text-gray-400 mb-4';
const routeHeadingClass = 'block text-sm tracking-[0.25em] uppercase text-gray-200';
const routeBodyClass = 'block text-gray-400 text-sm mt-3 leading-relaxed normal-case tracking-normal';

// Where each box of the diagram sits, matching t.flowSteps one for one: the
// title's anchor point, with its detail line drawn 17px below.
const flowPositions = [
  [155, 37], [155, 119], [155, 201], [155, 283],
  [485, 119], [485, 201], [320, 371], [320, 447],
];
const flowSteps = t.flowSteps.map((step, index) => ({ ...step, x: flowPositions[index][0], y: flowPositions[index][1] }));
const finalStep = flowSteps.length - 1;

// Japanese is set at its natural spacing; tightened tracking is for Latin.
const titleTracking = lang === 'ja' ? 'tracking-tight' : 'tracking-tighter';

const sections = [
  { heading: t.trialHeading, body: t.trial, note: t.trialNote },
  { heading: t.afterTrialHeading, body: t.afterTrial, note: t.afterTrialNote },
];
---

<Layout title={t.title} description={t.description}>

  <SiteHeader lang={lang} />

  <main class="max-w-4xl mx-auto px-6 pb-20">

    <section class="pt-10 mb-16">
      <h1 class:list={['text-5xl sm:text-6xl font-black mb-3', titleTracking]}>{t.heading}</h1>
      <p class="text-gray-400 text-sm tracking-wide uppercase" set:html={t.tagline.join(' &nbsp;·&nbsp; ')} />
    </section>

    <div class="max-w-2xl space-y-14">

      <!-- ── HOW IT WORKS ───────────────────────────────────────── -->
      <section>
        <p class="text-gray-300 leading-relaxed" set:html={t.howItWorks} />
      </section>

      <!-- ── THE SHAPE OF IT ────────────────────────────────────── -->
      <figure class="pt-2">
        <figcaption class="text-sm font-semibold tracking-[0.25em] uppercase text-gray-400 mb-5">
          {t.flowHeading}
        </figcaption>

        <div class="border border-gray-900 px-4 py-8 overflow-x-auto">
          <svg viewBox="0 0 640 490" role="img" aria-labelledby="flow-title flow-desc"
               class="w-full min-w-[560px] h-auto" fill="none">
            <title id="flow-title">{t.flowTitle}</title>
            <desc id="flow-desc">{t.flowDescription}</desc>

            <defs>
              <marker id="flow-arrow" viewBox="0 0 10 10" refX="9" refY="5"
                      markerWidth="6" markerHeight="6" orient="auto-start-reverse">
                <path d="M0 0 L10 5 L0 10 z" fill="#4b5563" />
              </marker>
            </defs>

            <!-- edges -->
            <g stroke="#4b5563" stroke-width="1" marker-end="url(#flow-arrow)">
              <path d="M155 68 V96" />
              <path d="M155 150 V178" />
              <path d="M155 232 V260" />
              <path d="M280 123 H360" />
              <path d="M485 150 V178" />
              <path d="M320 330 V348" />
              <path d="M320 402 V424" />
            </g>
            <g stroke="#4b5563" stroke-width="1">
              <path d="M155 314 V330 H320" />
              <path d="M485 232 V330 H320" />
            </g>

            <!-- edge labels -->
            <g font-size="10" fill="#6b7280" letter-spacing="0.08em">
              <text x="320" y="115" text-anchor="middle">{t.flowAnyTime}</text>
              <text x="170" y="325">{t.flowLaterKey}</text>
            </g>

            <!-- nodes -->
            <g stroke="#374151" stroke-width="1">
              <rect x="30" y="14" width="250" height="54" />
              <rect x="30" y="96" width="250" height="54" />
              <rect x="30" y="178" width="250" height="54" />
              <rect x="30" y="260" width="250" height="54" stroke-dasharray="4 4" stroke="#4b5563" />
              <rect x="360" y="96" width="250" height="54" />
              <rect x="360" y="178" width="250" height="54" />
              <rect x="145" y="348" width="350" height="54" />
              <rect x="105" y="424" width="430" height="54" stroke="#9ca3af" />
            </g>

            <g text-anchor="middle">
              <g font-size="13" fill="#e5e7eb">
                {flowSteps.map((step, index) => (
                  <text x={step.x} y={step.y} fill={index === finalStep ? '#ffffff' : undefined}>{step.title}</text>
                ))}
              </g>
              <g font-size="11" fill="#6b7280">
                {flowSteps.map((step) => (
                  <text x={step.x} y={step.y + 17}>{step.detail}</text>
                ))}
              </g>
            </g>
          </svg>
        </div>

        <p class="text-gray-400 text-xs mt-4 leading-relaxed">{t.flowNote}</p>
      </figure>

      <!-- ── 1–2. THE TRIAL, AND WHEN IT ENDS ───────────────────── -->
      {sections.map((section, index) => (
        <section>
          <h2 class={headingClass} set:html={`${index + 1} &nbsp;·&nbsp; ${section.heading}`} />
          <p class="text-gray-300 leading-relaxed mb-4" set:html={section.body} />
          <p class="text-gray-400 text-sm leading-relaxed">{section.note}</p>
        </section>
      ))}

      <!-- ── 3. BUYING ──────────────────────────────────────────── -->
      <section>
        <h2 class={headingClass} set:html={`3 &nbsp;·&nbsp; ${t.buyingHeading}`} />
        <p class="text-gray-300 leading-relaxed mb-6">{t.buyingIntro}</p>

        <div class="grid sm:grid-cols-2 gap-4 mb-6">
          <div class="border border-gray-800 px-6 py-5">
            <span class={routeHeadingClass}>{t.fromPluginHeading}</span>
            <span class={routeBodyClass} set:html={t.fromPlugin} />
          </div>

          <div class="border border-gray-800 px-6 py-5">
            <span class={routeHeadingClass}>{t.fromSiteHeading}</span>
            <span class={routeBodyClass} set:html={t.fromSite} />
          </div>
        </div>

        <p class="text-gray-400 text-sm leading-relaxed" set:html={t.payment} />
      </section>

      <!-- ── 4. ACTIVATION ──────────────────────────────────────── -->
      <section>
        <h2 class={headingClass} set:html={`4 &nbsp;·&nbsp; ${t.activationHeading}`} />
        <p class="text-gray-300 leading-relaxed mb-4" set:html={t.activation} />
        <p class="text-gray-400 text-sm leading-relaxed" set:html={t.activationNote} />
      </section>

      <!-- ── 5. HOW MANY MACHINES ───────────────────────────────── -->
      <section>
        <h2 class={headingClass} set:html={`5 &nbsp;·&nbsp; ${t.machinesHeading}`} />
        <p class="text-gray-300 leading-relaxed mb-4" set:html={t.machines} />
        <p class="text-gray-400 text-sm leading-relaxed">{t.machinesNote}</p>
      </section>

      <!-- ── QUESTIONS ──────────────────────────────────────────── -->
      <section>
        <h2 class={headingClass}>{t.supportHeading}</h2>
        <p class="text-gray-300 leading-relaxed">{t.support}</p>
      </section>

    </div>
  </main>

  <SiteFooter lang={lang} current="licensing" />

</Layout>
