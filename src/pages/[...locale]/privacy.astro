---
import Layout from '../../layouts/Layout.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import { formatDate, getLocalePaths, type Lang } from '../../i18n';
import copy from '../../translations/privacy';

export const getStaticPaths = getLocalePaths;

const { lang } = Astro.props as { lang: Lang };
const t = copy[lang];

// Bump this whenever the policy changes, in either language.
const lastUpdated = '2026-09-12';

const headingClass = 'text-sm font-semibold tracking-[0.25em] uppercase text-gray-400 mb-4';
const linkClass = 'text-gray-400 underline underline-offset-4 decoration-gray-500 hover:text-white transition-colors';

// Japanese is set at its natural spacing; tightened tracking is for Latin.
const titleTracking = lang === 'ja' ? 'tracking-tight' : 'tracking-tighter';
---

<Layout title={t.title} description={t.description}>

  <SiteHeader lang={lang} />

  <main class="max-w-4xl mx-auto px-6 pb-20">

    <section class="pt-10 mb-16">
      <h1 class:list={['text-5xl sm:text-6xl font-black mb-3', titleTracking]}>{t.heading}</h1>
      <p class="text-gray-400 text-sm tracking-wide uppercase">
        Datenschutzerklärung &nbsp;·&nbsp; {t.lastUpdated(formatDate(lastUpdated, lang, true))}
      </p>
    </section>

    <div class="max-w-2xl space-y-14">

      {t.translationNote && (
        <p class="text-gray-400 text-sm leading-relaxed border border-gray-800 px-5 py-4"
           set:html={t.translationNote} />
      )}

      {t.sections.map((section) => (
        <section>
          <h2 class={headingClass}>{section.heading}</h2>
          {section.blocks.map((block, index) => {
            const spacing = index < section.blocks.length - 1 ? 'mb-4' : undefined;
            if ('p' in block)
            {
              return <p class:list={['text-gray-300 leading-relaxed', spacing]} set:html={block.p} />;
            }
            if ('note' in block)
            {
              return <p class:list={['text-gray-400 text-sm leading-relaxed', spacing]} set:html={block.note} />;
            }
            if ('list' in block)
            {
              return (
                <ul class:list={['text-gray-300 leading-relaxed space-y-1 list-disc pl-5 marker:text-gray-400', spacing]}>
                  {block.list.map((item) => <li set:html={item} />)}
                </ul>
              );
            }
            return (
              <address class="text-gray-300 leading-relaxed not-italic">
                Landesbeauftragte für Datenschutz und Informationsfreiheit<br />
                Nordrhein-Westfalen<br />
                Kavalleriestraße 2–4<br />
                40213 Düsseldorf<br />
                Germany<br />
                <a href="https://www.ldi.nrw.de" rel="noopener noreferrer" target="_blank" class={linkClass}>ldi.nrw.de</a>
              </address>
            );
          })}
        </section>
      ))}

    </div>
  </main>

  <SiteFooter lang={lang} current="privacy" />

</Layout>
