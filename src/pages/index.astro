  <script>
    // The demos share a single frame: a track that scrolls one clip at a time,
    // with the tab strip above it serving as both label and position marker.
    const track = document.getElementById('demo-track');
    const slides = Array.from(track.children);
    const tabs = Array.from(document.querySelectorAll('#demos [data-demo-tab]'));
    const previous = document.querySelector('#demos [data-demo-nav="prev"]');
    const next = document.querySelector('#demos [data-demo-nav="next"]');

    const currentIndex = () => Math.round(track.scrollLeft / track.clientWidth);

    // Poster frames are heavy, so a slide only takes its own once it is the one
    // on show or the one after it. Four unseen frames cost nothing on arrival.
    const primePoster = (index) => {
      const slide = slides[index];
      if (!slide)
      {
        return;
      }

      const video = slide.querySelector('video');
      if (!video.getAttribute('poster'))
      {
        video.setAttribute('poster', video.dataset.poster);
      }
    };

    // Whatever moved the track — a tab, an arrow, a swipe — everything that
    // follows from the new position is settled in one place.
    const settle = () => {
      const index = currentIndex();

      tabs.forEach((tab, position) => {
        tab.setAttribute('aria-current', position === index ? 'true' : 'false');
      });

      // A clip scrolled out of the frame keeps playing otherwise, heard but not
      // seen, which is the one thing a single-clip carousel must not allow.
      slides.forEach((slide, position) => {
        if (position !== index)
        {
          slide.querySelector('video').pause();
        }
      });

      previous.disabled = index === 0;
      next.disabled = index === slides.length - 1;

      primePoster(index);
      primePoster(index + 1);
    };

    // The native control bar puts its play button in a corner, small; each clip
    // gets a large one in the middle of the frame that steps aside once the
    // clip is running and comes back the moment it stops.
    slides.forEach((slide) => {
      const video = slide.querySelector('video');
      const play = slide.querySelector('[data-demo-play]');

      play.addEventListener('click', () => video.play());

      const show = (visible) => {
        play.classList.toggle('opacity-0', !visible);
        play.classList.toggle('pointer-events-none', !visible);
      };

      video.addEventListener('play', () => show(false));
      video.addEventListener('pause', () => show(true));
      video.addEventListener('ended', () => show(true));
    });

    const goTo = (index) => {
      const target = Math.max(0, Math.min(slides.length - 1, index));
      track.scrollTo({ left: track.clientWidth * target, behavior: 'smooth' });
    };

    tabs.forEach((tab, index) => {
      tab.addEventListener('click', () => goTo(index));
    });

    previous.addEventListener('click', () => goTo(currentIndex() - 1));
    next.addEventListener('click', () => goTo(currentIndex() + 1));

    // Scrolling reports continuously; the position only matters once it stops.
    let settling;
    track.addEventListener('scroll', () => {
      clearTimeout(settling);
      settling = setTimeout(settle, 120);
    });

    // A resize changes what a slide's width means, so the track is put back on
    // a whole slide rather than left parked between two.
    let resizing;
    window.addEventListener('resize', () => {
      clearTimeout(resizing);
      resizing = setTimeout(() => goTo(currentIndex()), 150);
    });

    settle();
  </script>

